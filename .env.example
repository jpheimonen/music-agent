# Copy values into your shell environment; the server does not auto-load this file.
MUSIC_PORT=8787
MUSIC_LIBRARY_ROOT=/absolute/path/to/mp3s
# Relative data paths are resolved from the repository root, including under npm start.
MUSIC_DATA_DIR=./data
YOUTUBE_DATA_API_KEY=
# Uses your existing Codex login: MUSIC_CODEX_HOME, then CODEX_HOME, then ~/.codex.
# Set only if your existing login uses a different home. Relative paths use the repository root.
# MUSIC_CODEX_HOME=/absolute/path/to/existing/codex-home
# MUSIC_CODEX_BIN=/absolute/path/to/codex-0.156.1-or-its-js-shim
# Optional verified HTTPS replacements for future station adapter integration:
# MUSIC_STATION_KEXP_URL=
# MUSIC_STATION_YLE1_URL=
# MUSIC_STATION_RADIO_HELSINKI_URL=
