{
  "name": "@music/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/codex-worker.mjs dist/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@iarna/toml": "2.2.5",
    "@music/contracts": "0.1.0",
    "@openai/codex-sdk": "0.156.1",
    "fastify": "5.12.5",
    "music-metadata": "11.16.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
